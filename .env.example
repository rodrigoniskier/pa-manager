# Painel PA Manager
PAM_ADMIN_USERNAME=admin
PAM_ADMIN_PASSWORD=
PAM_SESSION_SECRET=
PAM_SECURE_COOKIES=false
PAM_TRUSTED_HOSTS=localhost,127.0.0.1

# Segurança operacional: mantenha true até concluir o primeiro teste controlado.
DRY_RUN=true
PAM_ALLOW_GLOBAL_RENEW=false
PAM_ALLOW_RELOAD=false
PAM_ALLOWED_REAL_ACCOUNTS=rodrigoniskier
PAM_BROWSER_FALLBACK=false
MAX_CONCURRENT_ACCOUNTS=3

# Arquivos e timeouts
PAM_ACCOUNTS_FILE=config/accounts.yaml
PAM_DB_PATH=data/pa_manager.db
PAM_REQUEST_TIMEOUT_SECONDS=20
PAM_HEALTH_TIMEOUT_SECONDS=12
PAM_LOCK_TTL_SECONDS=1800
# 0 em acesso direto; no Railway, 1 usa o IP mais à direita acrescentado pelo edge.
PAM_TRUSTED_PROXY_HOPS=0
PAM_LOG_LEVEL=INFO

# Credenciais PythonAnywhere. Nunca envie este arquivo ao Git.
PA_RODRIGONISKIER_PASSWORD=
PA_RODRIGONISKIER_API_TOKEN=
PA_RODRIGOBARBOSA_PASSWORD=
PA_RODRIGOBARBOSA_API_TOKEN=
